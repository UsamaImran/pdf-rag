{
  "name": "pdf-rag",
  "version": "1.0.0",
  "description": "PDF RAG is an end-to-end Retrieval-Augmented Generation system for processing and querying PDF documents. It handles PDF storage, text extraction, tokenization, token-aware chunking, Gemini embeddings, MongoDB vector search, and context-aware response generation.",
