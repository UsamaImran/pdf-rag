  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@google/genai": "^2.18.0",
    "bpe-lite": "^0.5.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.9.3",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
